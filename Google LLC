</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-glow">
    <div class="glow1"></div>
    <div class="glow2"></div>
    <div class="glow3"></div>
  </div>

  <div class="hero-content">
    <div class="eyebrow">
      <div class="ey-line"></div>
      <span class="ey-text">Digital Agency · Est. 2025</span>
    </div>
    <h1 class="hero-h1">
      <span class="w1">We Build</span>
      <span class="w2">Exceptional</span>
      <span class="w3">Digital.</span>
    </h1>
    <p class="hero-p">
      From stunning websites to powerful e-commerce stores and enterprise cloud hosting — we craft digital experiences that drive real business growth.
    </p>
    <div class="hero-btns">
      <button class="btn-red">Launch Your Vision</button>
      <button class="btn-ghost">
        See Our Work
        <span class="arr">→</span>
      </button>
    </div>
