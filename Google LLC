  <div class="hero-cards">
    <div class="hcard">
      <div class="hcard-num">200+</div>
      <div class="hcard-label">Projects Delivered</div>
    </div>
    <div class="hcard">
      <div class="hcard-num">99.9%</div>
      <div class="hcard-label">Uptime Guaranteed</div>
    </div>
    <div class="hcard">
      <div class="hcard-num">24/7</div>
      <div class="hcard-label">Support & Monitoring</div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-wrap">
  <div class="marquee-track">
    <span class="m-item"><span class="m-dot"></span>Web Design</span>
    <span class="m-item"><span class="m-dot"></span>E-Commerce</span>
    <span class="m-item"><span class="m-dot"></span>Cloud Hosting</span>
    <span class="m-item"><span class="m-dot"></span>Google Cloud</span>
